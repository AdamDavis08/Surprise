// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain
struct GrassData {
    float3 pos;
    float4 rot;
    float3 scale;
    float2 uv;
};

RWStructuredBuffer<GrassData> _ObjectDataBuffer;
RWStructuredBuffer<GrassData> _CulledObjectDataBuffer;
RWStructuredBuffer<GrassData> _CulledObjectDataBufferLOD;

float3 _ChunkPos;
float _DistanceToGrassThreshold;
float _DistanceToGrassLODThreshold;
float3 _CameraPos;

float FindSqrDistanceBetweenTwoPoints(float3 a, float3 b)
{
    return (a.x - b.x) * (a.x - b.x) + (a.z - b.z) * (a.z - b.z);
}
void CullObject(int i)
{
    GrassData defaultValue;
    defaultValue.pos = float3(10000, 10000, 10000);
    defaultValue.rot = float4(0, 0, 0, 0);
    defaultValue.scale = float3(0, 0, 0);
    defaultValue.uv = float2(0, 0);
    _CulledObjectDataBuffer[i] = defaultValue;
}

[numthreads(128,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    float3 grassWorldPos = _ObjectDataBuffer[id.x].pos.xyz + _ChunkPos.xyz;
    float3 camPos = float3(_CameraPos.xyz);
        
        _CulledObjectDataBuffer[id.x] = _ObjectDataBuffer[id.x];
    if (FindSqrDistanceBetweenTwoPoints(grassWorldPos, camPos) <= _DistanceToGrassThreshold)
    {
    }
    else
    {
        CullObject(id.x);
    }
}